# ==============================================================
# MERN Docker Compose Environment Template
# ==============================================================

# Application Ports
PORT=5000
CLIENT_PORT=3000
NGINX_PORT=80

# --------------------------------------------------------------
# MongoDB Configuration (Option A: Cloud MongoDB Atlas)
# --------------------------------------------------------------
# Set your MongoDB Atlas SRV connection string:
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/mern_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/mern_db?retryWrites=true&w=majority

# --------------------------------------------------------------
# MongoDB Configuration (Option B: Local Docker Container)
# --------------------------------------------------------------
# MONGO_URI=mongodb://admin:adminpassword@mongo:27017/mern_db?authSource=admin
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=adminpassword
MONGO_DB_NAME=mern_db
MONGO_PORT=27017

# Node Environment
NODE_ENV=development

# --------------------------------------------------------------
# Docker Hub Configuration
# --------------------------------------------------------------
# Replace with your Docker Hub username for building & pushing images
DOCKERHUB_USERNAME=yourusername
